# HITU AI Platform backend configuration
# Copy to .env locally. Do not commit .env or real secrets.

APP_NAME="HITU AI Platform"
APP_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL / Supabase pooler URL. URL-encode special characters in passwords.
DATABASE_URL=postgresql://<user>:<password>@<host>:6543/postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1800

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# JWT
JWT_SECRET=<minimum-32-character-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / cache
REDIS_URL=redis://localhost:6379/0

# AI engine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M

# CORS
CORS_ORIGINS=http://localhost,http://localhost:5173

# Upload protection
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=pdf,docx,pptx,xlsx,csv,zip,mp4,png,jpg,jpeg
ALLOWED_FILE_TYPES=.pdf,.docx,.pptx,.xlsx,.csv,.zip,.mp4,.png,.jpg,.jpeg

# Optional SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Optional seed passwords. Leave unset to generate ephemeral passwords at seed time.
SEED_ADMIN_PASSWORD=
SEED_DOCTOR_PASSWORD=
SEED_ASSISTANT_PASSWORD=
SEED_STUDENT_PASSWORD=
